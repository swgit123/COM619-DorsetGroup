---
extends: default

ignore: |
  node_modules/
  .git/
  .husky/
  .vscode/
  .vs/

rules:
  line-length:
    max: 120
    level: warning
  document-start:
    present: false
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
  comments:
    min-spaces-from-content: 1
  new-lines:
    type: unix
  new-line-at-end-of-file: enable
  trailing-spaces: enable
